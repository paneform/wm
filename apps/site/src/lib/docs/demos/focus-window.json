{
  "config": { "defaults": { "gap": 8, "margins": { "top": 28 } } },
  "presentation": {
    "device": "display",
    "showDock": false,
    "showKeyboard": false,
    "interactive": false
  },
  "state": {
    "topology": [
      {
        "id": "display:main",
        "frame": { "x": 0, "y": 0, "width": 1440, "height": 900 },
        "workspace": "1"
      }
    ],
    "windows": [
      {
        "id": "focused-window",
        "title": "Initially focused window",
        "workspace": "1",
        "frame": { "x": 0, "y": 28, "width": 720, "height": 872 }
      },
      {
        "id": "right-neighbor",
        "title": "Right neighbor",
        "workspace": "1",
        "frame": { "x": 720, "y": 28, "width": 720, "height": 872 }
      }
    ],
    "focusedWindow": "focused-window",
    "focusedWorkspace": "1"
  },
  "steps": [
    { "command": "reconcile", "expect": { "focusedWindow": "focused-window" } },
    {
      "playback": "start",
      "command": "focus-window right-neighbor",
      "caption": "The right neighbor takes focus; neither window moves.",
      "expect": {
        "focusedWindow": "right-neighbor",
        "windows": {
          "focused-window": { "frame": { "x": 0, "width": 716 } },
          "right-neighbor": { "frame": { "x": 724, "width": 716 } }
        }
      }
    }
  ]
}
