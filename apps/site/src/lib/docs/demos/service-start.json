{
  "config": { "defaults": { "margins": { "top": 28 } } },
  "presentation": {
    "device": "display",
    "showDock": false,
    "showKeyboard": false,
    "interactive": false
  },
  "state": {
    "topology": [
      {
        "id": "display:main",
        "frame": { "x": 0, "y": 0, "width": 1440, "height": 900 },
        "workspace": "1"
      }
    ],
    "windows": [
      {
        "id": "focused-window",
        "title": "Focused window",
        "workspace": "1",
        "frame": { "x": 80, "y": 80, "width": 640, "height": 400 }
      }
    ],
    "focusedWindow": "focused-window",
    "focusedWorkspace": "1",
    "wmRunning": false
  },
  "steps": [
    {
      "event": { "kind": "focus_changed", "windowId": "focused-window" },
      "expect": { "wmRunning": false }
    },
    {
      "playback": "start",
      "command": "service start",
      "caption": "The manager starts and tiles the focused window.",
      "expect": {
        "wmRunning": true,
        "windows": {
          "focused-window": {
            "workspace": "1",
            "frame": { "x": 0, "y": 28, "width": 1440, "height": 872 }
          }
        }
      }
    }
  ]
}
