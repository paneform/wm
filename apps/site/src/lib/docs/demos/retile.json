{
  "config": { "defaults": { "gap": 8, "margins": { "top": 28 } } },
  "presentation": {
    "device": "display",
    "showDock": false,
    "showKeyboard": false,
    "interactive": false
  },
  "state": {
    "topology": [
      {
        "id": "display:main",
        "frame": { "x": 0, "y": 0, "width": 1440, "height": 900 },
        "workspace": "1"
      }
    ],
    "windows": [
      {
        "id": "left-neighbor",
        "title": "Left neighbor",
        "workspace": "1",
        "frame": { "x": 80, "y": 80, "width": 600, "height": 400 }
      },
      {
        "id": "focused-window",
        "title": "Focused window",
        "workspace": "1",
        "frame": { "x": 720, "y": 80, "width": 600, "height": 400 }
      }
    ],
    "focusedWindow": "focused-window",
    "focusedWorkspace": "1"
  },
  "steps": [
    {
      "command": "state",
      "expect": { "windows": { "focused-window": { "frame": { "height": 400 } } } }
    },
    {
      "playback": "start",
      "command": "workspace retile --workspace 1",
      "caption": "The windows are refitted into full-height tiles.",
      "expect": {
        "windows": {
          "left-neighbor": { "frame": { "y": 28, "height": 872 } },
          "focused-window": { "frame": { "y": 28, "height": 872 } }
        }
      }
    }
  ]
}
