{
  "config": { "defaults": { "margins": { "top": 28 } } },
  "presentation": {
    "device": "display",
    "showDock": false,
    "showKeyboard": false,
    "interactive": false
  },
  "state": {
    "topology": [
      {
        "id": "display:main",
        "frame": { "x": 0, "y": 0, "width": 1440, "height": 900 },
        "workspace": "1"
      }
    ],
    "windows": [
      {
        "id": "focused-window",
        "title": "Focused window",
        "workspace": "1",
        "frame": { "x": 0, "y": 28, "width": 1440, "height": 872 }
      }
    ],
    "focusedWindow": "focused-window",
    "focusedWorkspace": "1"
  },
  "steps": [
    { "command": "reconcile", "expect": { "windows": { "focused-window": { "workspace": "1" } } } },
    {
      "playback": "start",
      "command": "window unmanage --window focused-window",
      "caption": "The focused window leaves manager control but stays open.",
      "expect": { "windows": { "focused-window": { "exists": true, "workspace": null } } }
    }
  ]
}
