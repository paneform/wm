{
  "config": { "defaults": { "margins": { "top": 28 } } },
  "presentation": {
    "device": "display",
    "showDock": false,
    "showKeyboard": false,
    "interactive": false
  },
  "state": {
    "topology": [
      {
        "id": "display:main",
        "frame": { "x": 0, "y": 0, "width": 1440, "height": 900 },
        "workspace": "1"
      }
    ],
    "windows": [
      {
        "id": "floating-window",
        "title": "Floating window",
        "workspace": "1",
        "floating": true,
        "frame": { "x": 80, "y": 108, "width": 640, "height": 400 }
      },
      {
        "id": "focused-window",
        "title": "Focused window",
        "workspace": "1",
        "floating": true,
        "frame": { "x": 480, "y": 300, "width": 720, "height": 440 }
      }
    ],
    "focusedWindow": "focused-window",
    "focusedWorkspace": "1"
  },
  "steps": [
    {
      "command": "state",
      "expect": {
        "windows": {
          "floating-window": { "floating": true },
          "focused-window": { "floating": true }
        }
      }
    },
    {
      "playback": "start",
      "command": "window float --toggle --window focused-window",
      "caption": "Toggling tiles the focused window over the floating peer.",
      "expect": {
        "windows": {
          "floating-window": {
            "floating": true,
            "frame": { "x": 80, "y": 108, "width": 640, "height": 400 }
          },
          "focused-window": {
            "floating": false,
            "frame": { "x": 0, "y": 28, "width": 1440, "height": 872 }
          }
        }
      }
    }
  ]
}
