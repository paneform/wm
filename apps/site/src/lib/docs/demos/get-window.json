{
  "presentation": {
    "device": "display",
    "showDock": false,
    "showKeyboard": false,
    "interactive": false
  },
  "state": {
    "topology": [
      {
        "id": "display:main",
        "frame": { "x": 0, "y": 0, "width": 1440, "height": 900 },
        "workspace": "1"
      }
    ],
    "windows": [
      {
        "id": "focused-window",
        "title": "Focused window",
        "workspace": "1",
        "frame": { "x": 0, "y": 28, "width": 1440, "height": 872 }
      }
    ],
    "focusedWindow": "focused-window",
    "focusedWorkspace": "1"
  },
  "steps": [
    { "command": "state", "expect": { "windows": { "focused-window": { "exists": true } } } },
    {
      "playback": "start",
      "command": "observe-window focused-window",
      "caption": "Read the focused window’s state without moving or resizing it.",
      "expect": {
        "windows": {
          "focused-window": {
            "exists": true,
            "frame": { "x": 0, "y": 28, "width": 1440, "height": 872 }
          }
        }
      }
    }
  ]
}
