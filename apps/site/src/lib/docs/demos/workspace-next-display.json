{
  "config": { "defaults": { "margins": { "top": 28 } } },
  "presentation": {
    "device": "display",
    "showDock": false,
    "showKeyboard": false,
    "interactive": false
  },
  "state": {
    "topology": [
      {
        "id": "display:main",
        "frame": { "x": 0, "y": 0, "width": 1440, "height": 900 },
        "workspace": "1",
        "primary": true
      },
      {
        "id": "display:second",
        "frame": { "x": 1440, "y": 0, "width": 1440, "height": 900 },
        "workspace": null
      }
    ],
    "windows": [
      {
        "id": "focused-window",
        "title": "Focused window",
        "workspace": "1",
        "frame": { "x": 0, "y": 28, "width": 1440, "height": 872 }
      }
    ],
    "focusedWindow": "focused-window",
    "focusedWorkspace": "1"
  },
  "steps": [
    {
      "command": "reconcile",
      "expect": { "windows": { "focused-window": { "frame": { "x": 0 } } } }
    },
    {
      "playback": "start",
      "command": "workspace move next",
      "caption": "The focused workspace and its window move to the next display.",
      "expect": {
        "focusedWorkspace": "1",
        "windows": {
          "focused-window": {
            "workspace": "1",
            "frame": { "x": 1440, "y": 28, "width": 1440, "height": 872 }
          }
        }
      }
    }
  ]
}
