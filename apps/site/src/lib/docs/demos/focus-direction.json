{
  "config": { "defaults": { "gap": 8, "margins": { "top": 28 } } },
  "presentation": {
    "device": "display",
    "showDock": false,
    "showKeyboard": false,
    "interactive": false
  },
  "state": {
    "topology": [
      {
        "id": "display:main",
        "frame": { "x": 0, "y": 0, "width": 1440, "height": 900 },
        "workspace": "1"
      }
    ],
    "windows": [
      {
        "id": "left-neighbor",
        "title": "Left neighbor",
        "workspace": "1",
        "frame": { "x": 0, "y": 28, "width": 720, "height": 872 }
      },
      {
        "id": "focused-window",
        "title": "Focused window",
        "workspace": "1",
        "frame": { "x": 720, "y": 28, "width": 720, "height": 872 }
      }
    ],
    "focusedWindow": "focused-window",
    "focusedWorkspace": "1"
  },
  "steps": [
    {
      "command": "reconcile",
      "expect": {
        "focusedWindow": "focused-window",
        "focusedWorkspace": "1",
        "windows": {
          "left-neighbor": { "frame": { "x": 0, "y": 28, "width": 716, "height": 872 } },
          "focused-window": { "frame": { "x": 724, "y": 28, "width": 716, "height": 872 } }
        }
      }
    },
    {
      "playback": "start",
      "command": "window focus left",
      "caption": "The left neighbor takes focus; neither window moves.",
      "expect": {
        "focusedWindow": "left-neighbor",
        "focusedWorkspace": "1",
        "windows": {
          "left-neighbor": { "frame": { "x": 0, "y": 28, "width": 716, "height": 872 } },
          "focused-window": { "frame": { "x": 724, "y": 28, "width": 716, "height": 872 } }
        }
      }
    }
  ]
}
