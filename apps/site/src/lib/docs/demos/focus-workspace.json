{
  "config": { "defaults": { "margins": { "top": 28 } } },
  "presentation": {
    "device": "display",
    "showDock": false,
    "showKeyboard": false,
    "interactive": false
  },
  "state": {
    "topology": [
      {
        "id": "display:main",
        "frame": { "x": 0, "y": 0, "width": 1440, "height": 900 },
        "workspace": "1"
      }
    ],
    "windows": [
      {
        "id": "focused-window",
        "title": "Focused window",
        "workspace": "1",
        "frame": { "x": 0, "y": 28, "width": 1440, "height": 872 }
      },
      {
        "id": "destination-window",
        "title": "Destination window",
        "workspace": "2",
        "frame": { "x": 0, "y": 28, "width": 1440, "height": 872 }
      }
    ],
    "focusedWindow": "focused-window",
    "focusedWorkspace": "1"
  },
  "steps": [
    { "command": "reconcile", "expect": { "focusedWorkspace": "1" } },
    {
      "playback": "start",
      "command": "workspace focus 2",
      "caption": "The destination workspace opens; its window takes focus.",
      "expect": {
        "focusedWorkspace": "2",
        "focusedWindow": "destination-window",
        "windows": {
          "destination-window": { "frame": { "x": 0, "y": 28, "width": 1440, "height": 872 } }
        }
      }
    }
  ]
}
