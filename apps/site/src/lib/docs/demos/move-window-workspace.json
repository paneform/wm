{
  "config": { "defaults": { "gap": 8, "margins": { "top": 28 } } },
  "presentation": {
    "device": "display",
    "showDock": false,
    "showKeyboard": false,
    "interactive": false
  },
  "state": {
    "topology": [
      {
        "id": "display:main",
        "frame": { "x": 0, "y": 0, "width": 1440, "height": 900 },
        "workspace": "1"
      }
    ],
    "windows": [
      {
        "id": "left-neighbor",
        "title": "Left neighbor",
        "workspace": "1",
        "frame": { "x": 0, "y": 28, "width": 720, "height": 872 }
      },
      {
        "id": "focused-window",
        "title": "Focused window",
        "workspace": "1",
        "frame": { "x": 720, "y": 28, "width": 720, "height": 872 }
      }
    ],
    "focusedWindow": "focused-window",
    "focusedWorkspace": "1"
  },
  "steps": [
    {
      "command": "reconcile",
      "expect": { "focusedWorkspace": "1", "windows": { "left-neighbor": { "workspace": "1" } } }
    },
    {
      "playback": "start",
      "command": "window assign 2 --window left-neighbor --no-follow",
      "caption": "The left neighbor moves; the focused window stays in view.",
      "expect": {
        "focusedWorkspace": "1",
        "focusedWindow": "focused-window",
        "windows": {
          "left-neighbor": { "workspace": "2" },
          "focused-window": {
            "workspace": "1",
            "frame": { "x": 0, "y": 28, "width": 1440, "height": 872 }
          }
        }
      }
    }
  ]
}
