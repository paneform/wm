{
  "config": { "defaults": { "mode": "floating", "margins": { "top": 28 } } },
  "presentation": {
    "device": "display",
    "showDock": false,
    "showKeyboard": false,
    "interactive": false
  },
  "state": {
    "topology": [
      {
        "id": "display:main",
        "frame": { "x": 0, "y": 0, "width": 1440, "height": 900 },
        "workspace": "1"
      }
    ],
    "windows": [
      {
        "id": "focused-window",
        "title": "Focused window",
        "workspace": "1",
        "frame": { "x": 80, "y": 80, "width": 640, "height": 400 }
      }
    ],
    "focusedWindow": "focused-window",
    "focusedWorkspace": "1"
  },
  "steps": [
    {
      "command": "reconcile",
      "expect": {
        "windows": {
          "focused-window": { "frame": { "x": 80, "y": 80, "width": 640, "height": 400 } }
        }
      }
    },
    {
      "playback": "start",
      "command": "workspace mode 1 bsp",
      "caption": "BSP mode tiles the focused window to fill the workspace.",
      "expect": {
        "windows": {
          "focused-window": { "frame": { "x": 0, "y": 28, "width": 1440, "height": 872 } }
        }
      }
    }
  ]
}
