{
  "name": "@paneform/layout-browser",
  "version": "0.1.0-alpha.0",
  "description": "Browser renderer and simulator for @paneform/layout",
  "keywords": [
    "browser",
    "layout",
    "simulation",
    "window-manager"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paneform/wm.git",
    "directory": "packages/layout-browser"
  },
  "files": [
    "dist",
    "styles.css"
  ],
  "type": "module",
  "sideEffects": [
    "./styles.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./styles.css"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./styles.css": "./styles.css"
    },
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "clean": "node -e \"for (const path of ['dist', 'playground-dist']) require('node:fs').rmSync(path, { recursive: true, force: true })\"",
    "build": "pnpm run clean && tsc -p tsconfig.build.json && vite build",
    "prepack": "pnpm run build",
    "prepublishOnly": "node ../../scripts/require-pnpm-publish.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint src test vite.config.ts vitest.config.ts",
    "lint:fix": "oxlint --fix src test vite.config.ts vitest.config.ts",
    "format": "oxfmt src test vite.config.ts vitest.config.ts package.json tsconfig.json tsconfig.build.json .oxlintrc.json .oxfmtrc.json",
    "format:check": "oxfmt --check src test vite.config.ts vitest.config.ts package.json tsconfig.json tsconfig.build.json .oxlintrc.json .oxfmtrc.json"
  },
  "dependencies": {
    "effect": "3.22.1"
  },
  "devDependencies": {
    "@paneform/layout": "workspace:*",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "typescript": "^5.9.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@paneform/layout": ">=0.1.0-alpha.0 <1"
  }
}
