{
  "name": "@wm/engine",
  "version": "2.0.0-alpha.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint src test vitest.config.ts",
    "lint:fix": "oxlint --fix src test vitest.config.ts",
    "format": "oxfmt src test vitest.config.ts package.json tsconfig.json .oxlintrc.json .oxfmtrc.json",
    "format:check": "oxfmt --check src test vitest.config.ts package.json tsconfig.json .oxlintrc.json .oxfmtrc.json"
  },
  "dependencies": {
    "effect": "3.22.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "fast-check": "^4.9.0",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  }
}
